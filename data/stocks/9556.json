763000.0,"shares_outstanding":4624400.0,"source_doc_id":"S100ZA18","restated":0},{"fiscal_year":"2024-07","net_sales":27077592000.0,"ordinary_income":1535418000.0,"operating_income":1506819000.0,"interim_dps":null,"total_assets":12139303000.0,"equity_ratio":39.4,"eps":97.18,"bps":513.75,"dps":null,"payout_ratio":null,"cash_equivalents":5708973000.0,"operating_cf":1227703000.0,"current_assets":9684979000.0,"current_liabilities":5269028000.0,"retained_earnings":2781055000.0,"interest_bearing_debt":2934442000.0,"shares_outstanding":4655210.0,"source_doc_id":"S100ZA18","restated":0},{"fiscal_year":"2025-07","net_sales":33551838000.0,"ordinary_income":2217488000.0,"operating_income":2186452000.0,"interim_dps":null,"total_assets":13631193000.0,"equity_ratio":45.2,"eps":146.49,"bps":657.75,"dps":null,"payout_ratio":null,"cash_equivalents":4071681000.0,"operating_cf":1739731000.0,"current_assets":8996315000.0,"current_liabilities":5372596000.0,"retained_earnings":4148755000.0,"interest_bearing_debt":1808918000.0,"shares_outstanding":4681970.0,"source_doc_id":"S100ZA18","restated":0},{"fiscal_year":"2026-07","net_sales":40399528000.0,"ordinary_income":1366849000.0,"operating_income":1337569000.0,"interim_dps":null,"total_assets":18294540000.0,"equity_ratio":36.4,"eps":54.75,"bps":706.44,"dps":null,"payout_ratio":null,"cash_equivalents":5533640000.0,"operating_cf":182128000.0,"current_assets":11599434000.0,"current_liabilities":6147700000.0,"retained_earnings":4606494000.0,"interest_bearing_debt":5601442000.0,"shares_outstanding":9416880.0,"source_doc_id":"S100ZA18","restated":0}],"dividend":{"score":null,"counts":null,"transitions":null,"tags":["安定的な還元"],"policy_text":"３ 【配当政策】当社は、株主に対する利益還元を経営上の重要課題の一つとして位置づけておりますが、内部留保の充実等を優先し、事業の効率化、事業拡大のための投資に充当していくことが株主に対する最大の利益還元につながると考えております。このことから創業以来配当は実施しておらず、今後においても当面の間は内部留保の充実を図る方針であります。将来的には、収益力の強化や事業基盤の整備を実施しつつ、内部留保の充実状況及び企業を取り巻く事業環境を勘案した上で、株主に対して安定的かつ継続的な利益還元を実施する方針でありますが、現時点において配当実施の可能性及びその実施時期等については未定であります。なお、剰余金の配当を行う場合、年１回の期末配当を基本方針としており、配当の決定機関は株主総会となっております。また、当社は会社法第454条第５項に規定する中間配当を取締役会の決議によって行うことができる旨を定款に定めております。","business_text":"３ 【事業の内容】当社グループは、当社及び連結子会社であるディクスホールディングス株式会社、KOZOCOM株式会社、クロスシステムサービス株式会社で構成されております。なお、アンダーワークス株式会社については、2026年8月時点で全株式を取得し、グループ会社化しております。当社グループは、「人も企業も、周囲の支えがなければ存在しえない」という想いを根底に、「Introduction LOOP　人と企業の成長が循環する社会の実現」をMission、「Intelligence LOOP for X　知の循環を生み出し、企業変革を加速する」をVisionとして設定しております。当社が強みとして保有する「変革への実行力」と「高度な専門性」により、顧客企業に対する付加価値の創出を目指しています。このMission・Valueの実現に向け、当社グループはプロフェッショナル人材ソリューション＆コンサルティング事業を展開しており、同事業の単一セグメントとなっております。プロフェッショナル人材ソリューションサービスでは、新規事業や業務改革など様々な経営課題を抱える顧客企業に対して、コンサルティングやシステム開発の知見を有する専門性の高いフリーランス人材を１名単位から提案し、プロジェクトへの参画を通じて課題解決を伴走支援しております。コンサルティングサービスでは、当社グループの社員コンサルタントにより、戦略、業務、IT及びDX領域におけるコンサルティング業務を提供しております。当社グループは、戦略策定から業務・システムの実装、内製化支援までを一貫して担う体制を有しており、グループ会社のシステム開発機能も活用しながら、顧客企業の要望やリソース状況に応じて自社社員とフリーランス人材を組み合わせたハイブリッドチームによるデリバリー体制を構築しております。 (1) プロフェッショナル人材ソリューションサービス当社グループのプロフェッショナル人材ソリューションサービスでは、フリーランス（コンサルタント/ITエンジニア）向け案件紹介プラットフォーム（High Performer Consultant、High Performer PMO、TECH STOCK、バチグマ）の登録人材の中から、顧客企業の案件内容とフリーランス人材の希望・スキルに応じてマッチングを行い、顧客企業へ提案いたします。顧客企業が提案内容に合意した後、実際のサービス提供が開始されます。顧客企業は、SIerやコンサルティングファーム、大手事業会社が中心であります。国内においては、人口減少に伴う労働力不足を背景として、業務の効率化・省人化への要望が高まっており、AI実装を含めたDX化ニーズが急速に拡大しております。このような外部環境の下、フリーランス人材の活用を試みる企業が増加している一方で、①人材の見極めが困難、②フリーランスとの契約関係の適正な管理が困難であり管理工数の負担が大きい、③人員離脱時の補填手段がない、等の課題も顕在化しております。当社グループは、これらの課題に対し、①知見を有する当社社員によるフリーランス人材の見極め、②当社の業務責任者の配置による適正な契約関係の維持及び顧客側管理工数の削減、③人員離脱時における24時間以内の代替人材の提案、等を行うことにより、顧客からの信頼を強化し、競合他社との差別化を図っております。その結果、当社グループに対する引き合いは増加しており、従来から取引のあるSIerやコンサルティングファームとの１社あたり取引規模の拡大に加え、事業会社との新規直接取引も増加傾向にあります。 一方、こうした顧客企業からの需要を支える供給側であるフリーランス人材は、2026年7月末現在、当社プラットフォームに約57,000名（うち稼働人数1,487名）が登録しており、日本最大級のプラットフォームを形成しています。登録者確保の施策としては、大手コンサルティングファームやSIer出身者等を対象としたWebマーケティングを中心とする広告宣伝活動を実施しております。これにより、専門性の高いスキルや経験を有する人材の登録が拡大しており、顧客からの信頼獲得と顧客満足度の高いデリバリーの実現に寄与しております。フリーランス人材には、継続的かつ安定的にデリバリーを行える環境を提供するため、①個人ネットワークでは獲得困難な案件の供給、②短期間の支払いサイトの実現（フリーランスへの支払いは末締め15日支払いを原則）③契約内容の調整、④フリーランス向け福利厚生サービスの提供、等を行っております。なお、案件紹介にあたっては、直接面談を実施した上で、本人のキャリア志向に沿った案件を提案し、本人の意向と顧客の特性の双方を見極めたマッチングを行っております。参画形態としてはフルタイムでのアサインが基本である一方、顧客のニーズやフリーランスの働き方に合わせて、柔軟なアサインも可能としています。コンサルティング案件は、顧客企業からの受注単価が140～300万円/月（最大500万円/月程度）、契約期間は３ヶ月から６ヶ月が中心です。ITエンジニア案件は、顧客企業からの発注単価が120万円から140万円程度、契約期間は１年以上が中心です。 (2) コンサルティングサービス当社グループは、様々な経営課題の解決や企業の変革を支援し、中長期的視点において顧客の利益創出を実現するためのコンサルティングサービスを提供しています。当社グループでは、社員であるコンサルタント/ITエンジニアが中心となり提供するサービスをコンサルティングサービスと位置づけております。サービス提供にあたっては、当社グループ社員を中心としたコンサルタント/ITエンジニアが、前述したフリーランスのコンサルタント/ITエンジニアとチームを組成、共同デリバリーを行うことで、顧客企業の支援を行っています。顧客は事業会社が中心であり、コンサルタントやITエンジニアといった1,000名以上のデリバリー社員（子会社含む）が在籍しており、これにフリーランスのコンサルタントの知見も組み合わせることで、顧客企業の多様なコンサルティングニーズに対応しております。提供領域は以下のとおり戦略策定からIT導入まで多岐にわたり、コンサルタントの単価は月額120～200万円（最大300万円程度）となっております。また、特定のITサービスやシステムに依存しないサービス提供を行っているため、中立的・客観的な立場からコンサルティングサービスを提供することが可能です。主な提供実績は以下のとおりです。・戦略コンサルティング（経営戦略・営業戦略策定、新規事業開発）・業務コンサルティング（SCM/CRM/BPR/BPM/RPA）・AI実装コンサルティング（AI活用戦略策定/データ基盤構築/AIガバナンス）・DXコンサルティング（デジタル施策立案/デジタルマーケティング）・ITコンサルティング（システム導入/PMO/プリセール支援）・ITシステム開発、インフラ開発 当社グループのコンサルティングサービスは、顧客企業のニーズによって、ご支援の形態も変わります。上流の戦略コンサルティングから支援をする企業に対しては、顧客企業の全体の業務改革や新システム導入等、総合的に支援するビジネスパートナーとなる一方で、大手コンサルティングファームとの取引のある企業の場合は、大手コンサルティングファームに不足する役割を補充するために、プロジェクトの一部を支援する場合もあります。当社グループ正社員及び当社グループのフリーランスネットワークから構成することで、小規模から大規模まで柔軟に対応することが可能です。 ＜事業系統図＞","policy_period":"2026-07-31"},"prices":{"monthly":{"d":["2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09","2026-10"],"p":[1491.0,2052.5,2205.0,2675.0,3390.0,3650.0,3710.0,3095.0,3730.0,3460.0,2720.0,2855.0,2810.0,2905.0,2260.0,2312.5,1622.5,1640.0,1922.