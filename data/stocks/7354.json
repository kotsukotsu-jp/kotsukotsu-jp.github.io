ました。なお、当事業年度に係る剰余金の配当は以下のとおりです。決議年月日配当金の総額（千円）１株当たり配当額（円）2026年２月20日325,0407.0取締役会決議","policy_period":"2025-12"},"prices":{"monthly":{"d":["2020-11","2020-12","2021-01","2021-02","2021-03","2021-04","2021-05","2021-06","2021-07","2021-08","2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[1285.8,1233.3,1641.0,1551.7,1591.6,1535.2,1706.8,1939.6,1760.9,1913.7,2043.0,2052.4,1805.6,1570.3,1322.3,1509.0,1722.2,1508.1,1707.1,1623.1,1947.6,1748.6,1536.4,1588.2,1410.0,1479.8,1568.5,1402.6,1294.8,1137.5,963.0,817.1,757.1,551.1,446.2,385.2,439.6,424.3,422.4,298.6,307.2,249.6,232.3,237.1,221.8,230.4,241.9,224.6,256.3,261.7,267.6,301.8,264.7,233.4,239.3,255.9,252.0,305.7,302.8,261.7,293.0,291.0,313.0,347.0,297.0,300.0,273.0,324.0,346.0,397.0,420.0]},"weekly":{"d":["2023-09-04","2023-09-11","2023-09-18","2023-09-25","2023-10-02","2023-10-09","2023-10-16","2023-10-23","2023-10-30","2023-11-06","2023-11-13","2023-11-20","2023-11-27","2023-12-04","2023-12-11","2023-12-18","2023-12-25","2024-01-01","2024-01-08","2024-01-15","2024-01-22","2024-01-29","2024-02-05","2024-02-12","2024-02-19","2024-02-26","2024-03-04","2024-03-11","2024-03-18","2024-03-25","2024-04-01","2024-04-08","2024-04-15","2024-04-22","2024-04-29","2024-05-06","2024-05-13","2024-05-20","2024-05-27","2024-06-03","2024-06-10","2024-06-17","2024-06-24","2024-07-01","2024-07-08","2024-07-15","2024-07-22","2024-07-29","2024-08-05","2024-08-12","2024-08-19","2024-08-2