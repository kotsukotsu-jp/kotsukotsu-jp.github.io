先とすべきとの判断から、配当を見送ることとしました。 当社グループは、早期の業績の回復と復配に向けて全力で取り組んでまいります。 また、内部留保につきましては、業績の向上と経営基盤の強化、コスト競争力の強化および市場ニーズに対応したサービス開発に投資してまいります。","policy_period":"2026-03"},"prices":{"monthly":{"d":["2016-10","2016-11","2016-12","2017-01","2017-02","2017-03","2017-04","2017-05","2017-06","2017-07","2017-08","2017-09","2017-10","2017-11","2017-12","2018-01","2018-02","2018-03","2018-04","2018-05","2018-06","2018-07","2018-08","2018-09","2018-10","2018-11","2018-12","2019-01","2019-02","2019-03","2019-04","2019-05","2019-06","2019-07","2019-08","2019-09","2019-10","2019-11","2019-12","2020-01","2020-02","2020-03","2020-04","2020-05","2020-06","2020-07","2020-08","2020-09","2020-10","2020-11","2020-12","2021-01","2021-02","2021-03","2021-04","2021-05","2021-06","2021-07","2021-08","2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[1203.4,1144.4,1161.8,1140.7,1326.7,1243.3,1218.4,1080.3,1082.3,1069.8,1028.6,1084.2,1510.8,2055.2,1441.1,1604.7,1570.0,1707.6,1387.2,1290.1,1238.1,1065.9,932.2,1006.3,1035.1,905.3,604.3,652.0,776.6,689.0,649.1,534.3,512.8,571.2,739.6,762.0,714.3,672.4,699.2,682.6,500.2,418.8,518.8,621.8,710.0,601.2,684.5,971.9,761.0,735.5,995.0,937.8,912.1,952.6,793.8,746.5,758.3,683.4,668.6,642.9,585.7,493.0,488.0,443.0,447.0,483.0,459.0,456.0,448.0,416.0,410.0,365.0,356.0,363.0,312.0,311.0,316.0,324.0,307.0,361.0,375.0,394.0,395.0,375.0,286.0,399.0,306.0,336.0,321.0,356.0,309.0,288.0,311.0,295.0,276.0,302.0,294.0,