りであります。 決議年月日配当金の総額(千円)１株当たり配当額(円)2026年５月15日取締役会決議216,01550","policy_period":"2026-03"},"prices":{"monthly":{"d":["2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[4115.3,3177.7,3724.9,4022.9,3706.3,5596.6,4851.7,6527.8,5503.5,4851.7,4935.5,4078.7,4022.9,3557.3,3088.5,2799.4,3366.3,3757.1,3799.4,3069.7,2871.9,2937.8,2867.2,2702.4,2714.7,2380.4,2392.9,2251.2,2239.7,2601.5,2640.8,2411.1,2143.1,2235.9,1740.1,1606.1,1543.9,1420.4,1485.5,1225.4,1491.4,1425.4,1393.8,1508.1,1585.9,1676.6,1872.6,2248.9,2594.6,3196.5,3275.0,3455.0,2675.0,3100.0,3225.0,3750.0,3705.0]},"weekly":{"d":["2023-09-04","2023-09-11","2023-09-18","2023-09-25","2023-10-02","2023-10-09","2023-10-16","2023-10-23","2023-10-30","2023-11-06","2023-11-13","2023-11-20","2023-11-27","2023-12-04","2023-12-11","2023-12-18","2023-12-25","2024-01-01","2024-01-08","2024-01-15","2024-01-22","2024-01-29","2024-02-05","2024-02-12","2024-02-19","2024-02-26","2024-03-04","2024-03-11","2024-03-18","2024-03-25","2024-04-01","2024-04-08","2024-04-15","2024-04-22","2024-04-29","2024-05-06","2024-05-13","2024-05-20","2024-05-27","2024-06-03","2024-06-10","2024-06-17","2024-06-24","2024-07-01","2024-07-08","2024-07-15","2024-07-22","2024-07-29","2024-08-05","2024-08-12","2024-08-19","2024-08-26","2024-09-02","2024-09-09","2024-09-16","2024-09-23","2024-09-30","2024-10-07","2024-10-14","2024-10-21","2024-10-28","2024-11-04","2024-11-11","2024-11-18","2024-11-25","2024-12-02","2024-12-09","2024-12-16","2024-12-2