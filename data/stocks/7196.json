る。」旨を定款に定めております。なお、当事業年度に係る剰余金の配当は以下のとおりであります。決議年月日配当金の総額（千円）１株当たり配当額（円）2026年４月24日136,23215.00定時株主総会決議（予定）","policy_period":"2026-01"},"prices":{"monthly":{"d":["2017-11","2017-12","2018-01","2018-02","2018-03","2018-04","2018-05","2018-06","2018-07","2018-08","2018-09","2018-10","2018-11","2018-12","2019-01","2019-02","2019-03","2019-04","2019-05","2019-06","2019-07","2019-08","2019-09","2019-10","2019-11","2019-12","2020-01","2020-02","2020-03","2020-04","2020-05","2020-06","2020-07","2020-08","2020-09","2020-10","2020-11","2020-12","2021-01","2021-02","2021-03","2021-04","2021-05","2021-06","2021-07","2021-08","2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[868.4,850.9,901.6,844.6,861.6,838.2,843.8,953.9,938.1,884.2,944.4,986.4,927.0,909.5,908.3,893.7,856.5,844.3,856.5,892.9,1041.2,972.3,1005.5,1051.7,1031.5,1138.4,1266.7,1012.5,759.2,906.1,1031.5,934.1,832.6,915.1,1010.9,1015.8,1056.2,870.6,817.6,844.8,849.9,776.7,811.6,850.7,797.1,793.7,838.8,772.5,746.9,792.9,729.3,737.3,739.9,702.0,742.5,766.3,747.8,754.9,705.5,745.2,758.4,775.1,751.6,752.6,757.1,785.4,786.3,831.0,802.7,790.9,790.9,745.3,800.9,819.1,791.4,775.3,786.7,788.6,820.6,862.1,805.5,783.8,787.6,794.2,807.4,803.6,784.9,781.0,822.2,800.6,794.7,850.6,807.5,811.4,750.6,699.7,701.6,700.6,713.0,728.0,718.0,737.0,750.0,786.0,740.0,747.0,747.0]},"weekly":{"d":["2023-09-04","2023-09-11","2023-09-18","2023-09-25","2023-10-02","2023-10-09","2023-10-16","2