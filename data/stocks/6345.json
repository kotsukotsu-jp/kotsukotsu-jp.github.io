。","policy_period":"2026-03"},"prices":{"monthly":{"d":["2016-11","2016-12","2017-01","2017-02","2017-03","2017-04","2017-05","2017-06","2017-07","2017-08","2017-09","2017-10","2017-11","2017-12","2018-01","2018-02","2018-03","2018-04","2018-05","2018-06","2018-07","2018-08","2018-09","2018-10","2018-11","2018-12","2019-01","2019-02","2019-03","2019-04","2019-05","2019-06","2019-07","2019-08","2019-09","2019-10","2019-11","2019-12","2020-01","2020-02","2020-03","2020-04","2020-05","2020-06","2020-07","2020-08","2020-09","2020-10","2020-11","2020-12","2021-01","2021-02","2021-03","2021-04","2021-05","2021-06","2021-07","2021-08","2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09","2026-10"],"p":[586.8,566.1,589.6,605.4,597.7,574.7,534.9,544.7,546.1,523.7,592.9,592.2,563.9,590.0,566.0,528.5,520.8,560.4,516.5,466.2,457.6,451.2,452.2,489.5,480.0,426.7,437.6,523.1,519.2,562.3,483.6,516.3,508.1,480.7,519.8,523.5,536.3,561.9,545.4,468.5,525.3,555.3,574.4,569.8,586.7,629.6,683.7,702.4,722.7,714.1,707.9,661.9,704.6,674.5,689.5,646.0,623.0,586.6,615.7,649.5,627.8,651.9,654.4,709.2,727.0,746.8,726.2,707.2,705.6,687.4,661.3,665.6,674.0,650.4,653.8,664.7,686.7,725.5,711.7,753.1,773.8,823.0,879.9,791.1,820.1,957.2,979.2,954.6,970.6,950.0,1041.3,1116.5,1133.5,1001.9,1068.5,1093.0,1252.3,1320.5,1308.7,1365.1,1179.6,1200.2,1290.0,1265.7,1209.6,1240.4,1306.6,1232.1,1271.3,1308.5,1302.8,1401.2,1270.1,1362.0,1366.8,1321.9,1418.7,1446.0,14