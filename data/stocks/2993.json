す。内部留保資金につきましては、今後の持続的成長のための投資原資として活用する予定であります。 なお、当社は取締役会の決議により毎年９月30日を基準日として中間配当を行うことができる旨を定款に定めております。 当事業年度に係る剰余金の配当は次のとおりであります。決議年月日配当金の総額（千円）１株当たり配当額（円）2026年６月25日548,371125定時株主総会決議（予定）","policy_period":"2026-03"},"prices":{"monthly":{"d":["2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[1199.3,1222.3,1367.9,1362.1,1315.7,1343.4,1355.6,1438.0,1381.7,1417.6,1479.5,1483.6,1492.6,1548.0,1780.9,1769.8,1715.0,1757.8,1768.0,1714.1,1869.9,1788.6,1792.0,1817.7,1861.4,1842.5,2001.9,1969.6,1842.1,1811.6,1822.3,1755.0,1761.3,1795.4,1841.2,1802.6,1817.9,1867.2,2000.8,1993.2,1916.2,1929.5,1939.0,2037.9,2113.0,2117.8,2120.6,2139.7,2227.2,2479.2,2397.0,2380.0,2070.0,2150.0,2131.0,2233.0,2219.0]},"weekly":{"d":["2023-09-04","2023-09-11","2023-09-18","2023-09-25","2023-10-02","2023-10-09","2023-10-16","2023-10-23","2023-10-30","2023-11-06","2023-11-13","2023-11-20","2023-11-27","2023-12-04","2023-12-11","2023-12-18","2023-12-25","2024-01-01","2024-01-08","2024-01-15","2024-01-22","2024-01-29","2024-02-05","2024-02-12","2024-02-19","2024-02-26","2024-03-04","2024-03-11","2024-03-18","2024-03-25","2024-04-01","2024-04-08","2024-04-15","2024-04-22","2024-04-29","2024-05-06","2024-05-13","2024-05-20","2024-05-27","2024-06-03","2024-06-10","2024-06-17","2024-06-24","2024-07-01","2024-07-08","2024-07-15","2024-07-22","2024-07-29","2024-08-05","2024-08-12","2024-08-19","2024-08-26","2024-09-02","2024-09-09","2024-09-16","2024-09-23","2024-09-30","2024-10-07","2024-10-1