備えるものとして、株主の皆様には誠に申し訳なく存じますが無配とさせていただきます。なお、次期の配当につきましては、引き続き上述の方針に基づき実施する予定でありますが、同期間における業績予想が困難なことから未定としております。","policy_period":"2025-11"},"prices":{"monthly":{"d":["2016-10","2016-11","2016-12","2017-01","2017-02","2017-03","2017-04","2017-05","2017-06","2017-07","2017-08","2017-09","2017-10","2017-11","2017-12","2018-01","2018-02","2018-03","2018-04","2018-05","2018-06","2018-07","2018-08","2018-09","2018-10","2018-11","2018-12","2019-01","2019-02","2019-03","2019-04","2019-05","2019-06","2019-07","2019-08","2019-09","2019-10","2019-11","2019-12","2020-01","2020-02","2020-03","2020-04","2020-05","2020-06","2020-07","2020-08","2020-09","2020-10","2020-11","2020-12","2021-01","2021-02","2021-03","2021-04","2021-05","2021-06","2021-07","2021-08","2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[532.2,561.2,564.1,576.6,592.0,553.0,527.6,567.6,556.9,567.6,1066.0,1164.5,1004.5,834.8,717.8,778.3,788.0,739.8,676.9,673.9,660.2,635.6,633.6,619.8,615.9,610.0,587.4,657.2,677.9,610.3,598.4,595.4,576.5,585.4,556.6,568.5,616.3,628.2,623.2,625.2,508.9,482.0,458.0,500.0,498.0,479.0,477.0,486.0,480.0,495.0,498.0,508.0,558.0,526.0,474.0,458.0,482.0,481.0,477.0,485.0,494.0,502.0,511.0,509.0,510.0,472.0,465.0,468.0,469.0,472.0,472.0,470.0,478.0,490.0,477.0,505.0,504.0,469.0,474.0,473.0,481.0,483.0,473.0,477.0,480.0,277.0,345.0,330.0,329.0,352.0,348.0,358.0,391.0,380.0,356.0,311.0,310.0,312.0,320.0,341.0,327.0,325.0,311.0,321.0,