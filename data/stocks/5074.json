又は取締役会であります。なお、第16期（2025年６月期）に係る剰余金の配当は、2025年９月26日開催予定の定時株主総会において、以下のとおり決議する予定であります。 決議年月日配当金の総額（百万円）１株当たり配当額（円）2025年９月26日3615.12定時株主総会決議（予定）","policy_period":"2025-06"},"prices":{"monthly":{"d":["2021-05","2021-06","2021-07","2021-08","2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[1553.5,1643.1,2161.1,1803.2,2006.4,2104.4,2178.2,1853.5,1308.5,1170.9,1425.4,1263.6,1219.5,1079.6,1133.6,1108.9,864.6,936.0,1017.4,947.0,1076.9,956.1,990.9,1091.5,912.2,857.4,538.8,492.9,492.9,443.2,414.2,408.6,431.1,436.7,441.4,405.8,385.1,424.8,398.5,289.4,286.5,274.8,267.0,270.9,263.1,251.4,265.0,324.5,343.0,326.8,436.7,361.4,433.7,345.6,346.6,348.5,364.4,602.0,558.5,765.4,1049.6,932.0,678.0,650.0,588.0]},"weekly":{"d":["2023-09-04","2023-09-11","2023-09-18","2023-09-25","2023-10-02","2023-10-09","2023-10-16","2023-10-23","2023-10-30","2023-11-06","2023-11-13","2023-11-20","2023-11-27","2023-12-04","2023-12-11","2023-12-18","2023-12-25","2024-01-01","2024-01-08","2024-01-15","2024-01-22","2024-01-29","2024-02-05","2024-02-12","2024-02-19","2024-02-26","2024-03-04","2024-03-11","2024-03-18","2024-03-25","2024-04-01","2024-04-08","2024-04-15","2024-04-22","2024-04-29","2024-05-06","2024-05-13","2024-05-20","2024-05-27","2024-06-03","2024-06-10","2024-06-17","2024-06-24","2024-07-01","2024-07-08","2024-07-15","2024-07-22","2024-07-29","2024-08-05","2024-08-12","2024-08-19","2024-08-26","2024-09-02","2024-09-09","2024-09-16","2024-