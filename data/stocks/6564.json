活用してまいりたいと考えております。なお、当事業年度に係る剰余金の配当は以下のとおりであります。決議年月日配当金の総額（千円）１株当たり配当額（円）2026年５月15日498,24418取締役会決議","policy_period":"2026-03"},"prices":{"monthly":{"d":["2018-01","2018-02","2018-03","2018-04","2018-05","2018-06","2018-07","2018-08","2018-09","2018-10","2018-11","2018-12","2019-01","2019-02","2019-03","2019-04","2019-05","2019-06","2019-07","2019-08","2019-09","2019-10","2019-11","2019-12","2020-01","2020-02","2020-03","2020-04","2020-05","2020-06","2020-07","2020-08","2020-09","2020-10","2020-11","2020-12","2021-01","2021-02","2021-03","2021-04","2021-05","2021-06","2021-07","2021-08","2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[223.8,223.8,223.8,223.8,223.8,223.8,223.8,223.8,223.8,223.8,223.8,268.0,293.9,297.6,304.3,314.6,313.1,399.5,452.3,451.1,552.1,647.5,788.4,819.4,702.7,491.9,440.4,558.3,800.9,864.7,695.2,883.2,1068.8,1310.4,1649.0,1466.3,1673.3,1987.6,2389.5,2501.7,2950.3,3652.5,5003.4,4345.0,5247.2,5266.7,4842.4,3969.5,2580.7,2266.6,2678.5,2072.6,2787.0,2729.3,2864.2,3146.6,3273.6,3615.6,3293.2,2511.4,2757.7,2695.1,2110.8,1863.9,1631.8,1493.7,1584.8,1801.3,1865.9,1712.1,1716.0,2064.7,1816.9,1529.0,1550.3,1406.6,1484.4,1493.2,1578.9,1718.6,1747.2,1829.9,1651.7,1535.6,1633.0,2120.2,2051.0,2257.0,2083.6,2040.1,2156.0,1981.6,1974.7,1835.0,1836.9,1902.3,1982.6,2066.8,1917.0,2120.0,2120.0,2031.0,2191.0,2048.0,1979.0]},"weekly":{"d":["2023-09-04","2023-09-11","2023-09-18","2023-09-25","2023-10-02","2023