項に定める中間配当をすることができる旨を定款に定めております。これらの方針に基づき、当事業年度の期末配当につきましては、１株当たり25円としております。 当事業年度に係る剰余金の配当は、以下のとおりであります。決議年月日配当金の総額（千円）１株当たり配当額（円）2026年３月26日定時株主総会決議予定210,66525.00","policy_period":"2025-12"},"prices":{"monthly":{"d":["2019-04","2019-05","2019-06","2019-07","2019-08","2019-09","2019-10","2019-11","2019-12","2020-01","2020-02","2020-03","2020-04","2020-05","2020-06","2020-07","2020-08","2020-09","2020-10","2020-11","2020-12","2021-01","2021-02","2021-03","2021-04","2021-05","2021-06","2021-07","2021-08","2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[2220.0,2899.4,2247.0,2515.7,2367.9,2005.4,2276.0,2179.4,2423.9,2667.5,1588.9,1492.2,1645.9,1797.6,1761.9,1546.4,1720.3,2319.5,1947.4,1789.9,1649.8,1627.5,2102.1,2617.2,2419.1,2034.4,1987.1,1747.4,1889.5,2024.8,1923.3,2149.4,2231.6,1631.4,1893.3,1731.9,1677.8,1453.6,1325.0,1519.3,2126.2,1846.0,2009.3,2562.1,2497.4,2303.1,3034.7,3261.8,3406.8,2967.1,3121.7,2705.2,2537.0,2443.2,2167.8,2170.7,2188.1,2348.5,2001.6,1589.8,1385.0,1438.1,1408.2,1413.0,1385.9,1465.2,1395.6,1274.8,1358.1,1355.2,1456.8,1514.5,1447.1,1184.2,1063.1,1013.2,1285.8,1280.0,1322.0,1271.2,1120.0,1032.0,905.0,720.0,741.0,633.0,523.0,562.0,475.0,477.0]},"weekly":{"d":["2023-09-04","2023-09-11","2023-09-18","2023-09-25","2023-10-02","2023-10-09","2023-10-16","2023-10-23","2023-10-30","2023-11-06","2023-11-13","2023-11-20","2023-11-27","2023-12-04","2023-12-11","2023-12-18","2023-12-25","2024-01-01","20