経営基盤の安定に向けた財務体質の強化及び事業成長に向けた投資のための資金として有効に活用していく所存であります。 当事業年度に係る剰余金の配当は以下のとおりです。決議年月日配当金の総額（千円）１株当たり配当額（円）2026年3月26日103,43028.00定時株主総会決議","policy_period":"2025-12"},"prices":{"monthly":{"d":["2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[2953.5,3376.8,2872.7,1604.7,1535.8,1739.6,1586.0,1592.9,1467.9,1660.8,1745.5,1535.8,1470.8,1516.1,1254.2,1275.9,1448.2,1811.5,1687.4,1627.4,1777.0,1737.6,2316.5,2576.4,2105.8,2466.1,2532.1,2471.1,2882.6,2658.1,2255.5,2107.8,2128.5,2605.0,2402.1,2254.5,2083.2,2382.5,2481.7,2317.3,2213.3,2041.9,2095.4,2228.1,2455.0,2595.7,3100.9,3269.4,2808.7,3006.8,2994.0,2512.0,2386.0,2309.0,2302.0,2533.0,2321.0,2291.0,2528.0,2443.0]},"weekly":{"d":["2023-09-04","2023-09-11","2023-09-18","2023-09-25","2023-10-02","2023-10-09","2023-10-16","2023-10-23","2023-10-30","2023-11-06","2023-11-13","2023-11-20","2023-11-27","2023-12-04","2023-12-11","2023-12-18","2023-12-25","2024-01-01","2024-01-08","2024-01-15","2024-01-22","2024-01-29","2024-02-05","2024-02-12","2024-02-19","2024-02-26","2024-03-04","2024-03-11","2024-03-18","2024-03-25","2024-04-01","2024-04-08","2024-04-15","2024-04-22","2024-04-29","2024-05-06","2024-05-13","2024-05-20","2024-05-27","2024-06-03","2024-06-10","2024-06-17","2024-06-24","2024-07-01","2024-07-08","2024-07-15","2024-07-22","2024-07-29","2024-08-05","2024-08-12","2024-08-19","2024-08-26","2024-09-02","2024-09-09","2024-09-16","2024-09-23","2024-09-30","2024-10-07","2024-10-14