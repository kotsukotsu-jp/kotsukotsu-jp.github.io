ます。 以上に述べた事項を事業系統図によって示すと次のとおりであります。","policy_period":"2026-03"},"prices":{"monthly":{"d":["2016-11","2016-12","2017-01","2017-02","2017-03","2017-04","2017-05","2017-06","2017-07","2017-08","2017-09","2017-10","2017-11","2017-12","2018-01","2018-02","2018-03","2018-04","2018-05","2018-06","2018-07","2018-08","2018-09","2018-10","2018-11","2018-12","2019-01","2019-02","2019-03","2019-04","2019-05","2019-06","2019-07","2019-08","2019-09","2019-10","2019-11","2019-12","2020-01","2020-02","2020-03","2020-04","2020-05","2020-06","2020-07","2020-08","2020-09","2020-10","2020-11","2020-12","2021-01","2021-02","2021-03","2021-04","2021-05","2021-06","2021-07","2021-08","2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09","2026-10"],"p":[481.0,573.5,588.5,559.1,520.3,525.3,547.1,535.5,538.4,532.6,583.0,591.1,586.0,596.9,643.0,641.6,636.9,617.0,575.5,567.4,573.3,567.4,579.7,517.6,516.1,455.5,432.3,457.8,449.9,459.8,434.0,429.4,427.2,394.5,461.0,485.6,454.0,473.3,440.2,380.2,352.8,354.3,363.7,383.1,337.2,323.2,334.9,337.2,328.6,306.8,313.1,348.9,379.9,357.7,356.1,363.2,354.5,348.9,344.1,339.3,343.3,368.3,349.0,365.8,373.0,349.3,350.1,354.2,348.5,348.5,333.8,323.0,334.6,332.9,338.7,364.4,374.4,380.2,444.0,502.0,570.8,691.7,599.7,556.9,784.8,741.1,819.0,971.5,1013.2,974.4,725.1,739.2,734.8,719.8,663.0,656.7,605.3,664.8,641.4,648.6,671.7,823.1,764.4,757.8,832.5,891.2,968.6,929.3,866.0,944.7,923.6,1240.1,968.0,969.0,991.5,961.1,981.7