source_doc_id":"S100ZJNJ","restated":0},{"fiscal_year":"2023-08","net_sales":1382668000.0,"ordinary_income":-69877000.0,"operating_income":-68131000.0,"interim_dps":null,"total_assets":746927000.0,"equity_ratio":30.3,"eps":-80.33,"bps":272.15,"dps":null,"payout_ratio":null,"cash_equivalents":367946000.0,"operating_cf":26811000.0,"current_assets":545297000.0,"current_liabilities":446850000.0,"retained_earnings":-232820000.0,"interest_bearing_debt":155240000.0,"shares_outstanding":832250.0,"source_doc_id":"S100ZJNJ","restated":0},{"fiscal_year":"2024-08","net_sales":1515249000.0,"ordinary_income":-39306000.0,"operating_income":-38541000.0,"interim_dps":null,"total_assets":904460000.0,"equity_ratio":26.400000000000002,"eps":2.83,"bps":283.96,"dps":null,"payout_ratio":null,"cash_equivalents":438646000.0,"operating_cf":-38198000.0,"current_assets":660261000.0,"current_liabilities":448001000.0,"retained_earnings":-230454000.0,"interest_bearing_debt":290672000.0,"shares_outstanding":839522.0,"source_doc_id":"S100ZJNJ","restated":0},{"fiscal_year":"2025-08","net_sales":1544788000.0,"ordinary_income":-20614000.0,"operating_income":-17686000.0,"interim_dps":null,"total_assets":994459000.0,"equity_ratio":28.000000000000004,"eps":33.85,"bps":326.99,"dps":null,"payout_ratio":null,"cash_equivalents":489447000.0,"operating_cf":131738000.0,"current_assets":739350000.0,"current_liabilities":551989000.0,"retained_earnings":-201895000.0,"interest_bearing_debt":247422000.0,"shares_outstanding":851328.0,"source_doc_id":"S100ZJNJ","restated":0},{"fiscal_year":"2026-08","net_sales":1512025000.0,"ordinary_income":-87816000.0,"operating_income":-82695000.0,"interim_dps":null,"total_assets":722663000.0,"equity_ratio":5.5,"eps":-295.64,"bps":45.59,"dps":null,"payout_ratio":null,"cash_equivalents":275761000.0,"operating_cf":-214978000.0,"current_assets":588635000.0,"current_liabilities":492255000.0,"retained_earnings":-456980000.0,"interest_bearing_debt":279512000.0,"shares_outstanding":869598.0,"source_doc_id":"S100ZJNJ","restated":0}],"dividend":{"score":null,"counts":null,"transitions":null,"tags":["無配・方針未定"],"policy_text":"３ 【配当政策】当社は、企業価値を継続的に拡大し、株主に対して利益還元することを重要な経営課題と認識しておりますが、現時点において、財務体質の強化及びサービス提供に関するシステム整備等のため、内部留保の充実を図ることが重要であると考え、無配を継続してまいりました。今後の配当政策の基本方針としましては、財務体質の強化を目的とした内部留保の充実を当面の優先事項としたうえで、経営成績、財政状態及び事業展開を勘案しつつ株主への利益還元を検討していく予定であります。　なお、剰余金の配当を行う場合は、年１回の期末配当を基本方針としており、その他に中間配当を行うことができる旨及び基準日を設けて剰余金の配当を行うことができる旨を定款に定めており、配当の決定機関は、中間配当は取締役会、期末配当及びその他の剰余金は株主総会であります。","business_text":"３ 【事業の内容】当社グループは、当連結会計年度末現在、当社及び連結子会社２社（株式会社公共ＢＰＯと地域活性ＡＩテクノロジーズ株式会社）で構成されております。なお、当連結会計年度末後の2026年10月１日付で、当社のふるさと納税事業を新設分割により株式会社フューチャーリンクローカルサポートに承継しております。 当社グループは、「地域活性化を継続的かつ発展的事業の形で実現することで、社会に貢献する。」を企業理念としております。地域に埋もれている魅力や付加価値を情報として流通させるとともに、官民協働による地域課題の解決に取り組み、持続可能な地域社会の実現を目指しております。 事業の基盤となる地域情報プラットフォーム「まいぷれ」は、地域の店舗・施設、イベント、暮らしに役立つ情報等を収集・編集し、多様なメディアやチャネルを通じて発信する仕組みであります。地域の担当者による取材や継続的な対話を通じて得られる一次情報、共通のシステム・ＡＩ基盤及び地域に根差した運営ノウハウを組み合わせ、地域事業者の情報発信及び経営を支援しております。 当社グループの事業は、「地域情報流通事業」及び「公共ソリューション事業」の２つの報告セグメントで構成されております。地域情報流通事業では、地域情報プラットフォーム「まいぷれ」を軸としたＭＲＲ、マーケティング支援、関係人口創出及びその他の事業を展開し、公共ソリューション事業では、ふるさと納税業務支援及びその他の公共案件・地域ポイントに関する事業を展開しております。 当社グループの事業系統図は、次のとおりであります。 ［事業系統図］ 各セグメントの事業内容は次の通りとなります。 (1) 地域情報流通事業地域情報流通事業では、地域情報プラットフォーム「まいぷれ」を基盤として、地域事業者の集客・情報発信及び経営を支援しております。また、地域との接点や情報流通の仕組みを活かし、企業のマーケティング支援、関係人口の創出及びＡＩ活用支援等を行っております。 ①　ＭＲＲ地域事業者に継続的にサービスを提供し、その対価として月額利用料等を受け取る事業であります。ＭＲＲはMonthly Recurring Revenue（月次経常収益）の略称であり、当社グループの継続収益の基盤となっております。 地域の担当者が取材や対話を通じて店舗の強み、こだわり及び課題を把握し、「まいぷれ」への店舗情報の掲載やニュースの配信、Googleマップ及びＳＮＳ等を活用した情報発信を支援しております。地域情報特化型ＡＩエージェント「まいぷれくん」では、投稿文、ＰＲ文及び口コミへの返信文等の作成を支援し、地域事業者が自店の魅力を継続的に発信できる環境を提供しております。また、専属スタッフが情報発信を支援する「まるまるおまかせプラン」等を提供しております。 これらのサービスは、直営、パートナー、ＯＥＭ及びグローバルの４つの経路で展開しております。 ａ．直営当社が地域事業者に対して直接、営業、取材及びサービスの活用支援等を行う形態であります。千葉県船橋市をはじめとする直営エリアにおいて、「まいぷれ」への情報掲載及び各種情報発信支援サービスを提供し、地域事業者からプラットフォーム利用料を受け取っております。 ｂ．パートナー全国各地域の運営パートナーが、地域事業者への営業、取材及びサービスの活用支援等を担い、当社が共通のシステム・ＡＩ基盤及び運営ノウハウを提供する形態であります。地域に根差した運営パートナーの活動と当社のサービス基盤を組み合わせることで、全国各地への展開を行っております。 ［運営パートナーとの関係図］ 主な継続収益は、運営パートナーから受け取る固定ランニング費用及び地域事業者へのサービス提供による収益の分配であります。収益分配の条件は商品及び契約により異なり、「まいぷれ」の基本商品に係るプラットフォーム利用料については、その20％を受け取っております。 当連結会計年度末現在、全国134社の運営パートナーとともに、47都道府県・884市区町村において「まいぷれ」を展開しております。 ｃ．ＯＥＭ地域活性ＡＩテクノロジーズ株式会社を通じて、協業先にシステム・ＡＩ基盤を提供し、協業先のブランド及び顧客基盤を活用してサービスを展開する形態であります。協業先が地域事業者等に自社ブランドでサービスを提供し、当社グループは、システム・ＡＩ基盤の提供、開発及び保守等の対価として、協業先からシステム利用料等を受け取る仕組みであります。 ｄ．グローバル国内で培った地域事業者の情報発信支援の仕組み及び運営ノウハウを、現地の言語や商習慣に合わせて海外に展開する形態であります。ベトナム・ホーチミン市において現地企業と連携し、地域事業者の集客及び情報発信を支援しております。主な収益は、地域事業者から受け取るプラットフォーム利用料であります。 ②　マーケティング支援地域情報プラットフォーム「まいぷれ」と全国の運営体制を活用し、企業の販促、広告及び制作等を支援しております。特定の商圏や地域に情報を届けたい企業に対して、地域メディアを活用したプロモーション、取材記事による商品・サービスの紹介、ウェブマーケティング、地域のコミュニティと連動した企画、イベントの企画・運営等を提供しております。顧客の課題に応じて施策を企画・実施し、企画料、制作費、広告料及び運営業務の受託料等を受け取っております。 ③　関係人口創出地域外に暮らしながら地域と継続的かつ多様に関わる「関係人口」の創出・拡大を支援しております。地域の「人・体験・拠点」を結び付け、情報発信や交流プログラムの企画・運営、地域企業の課題解決に関わる人材との接点づくり及び採用・育成支援等を通じて、地域外の人や企業が地域に関わり続けられる機会を提供しております。自治体や企業等から、企画・運営及び支援業務の対価を受け取っております。 ④　その他地域活性ＡＩテクノロジーズ株式会社を中心に、企業専用のＡＩエージェントの構築、ＡＩに関する研修及び活用定着支援等を行い、開発・導入支援及び研修等の対価を受け取っております。その他にも、新たに「まいぷれ」の運営パートナーとなる企業に対し、運営許諾及び初期導入支援等を提供し、パートナー加盟料を受け取っております。 (2) 公共ソリューション事業公共ソリューション事業では、地域に根差した運営体制と情報流通の仕組みを活用し、自治体等の抱える課題に対して官民協働による解決策を提供しております。主な事業は、ふるさと納税業務支援、自治体ＤＸ支援及び地域共通ポイントの開発・運営等であります。 ①　ふるさと納税業務支援自治体、返礼品提供事業者及び寄付者を対象に、ふるさと納税に関する業務を包括的に支援しております。地域事業者の開拓、返礼品の開発、商品や地域の魅力を伝える情報発信及び販促施策の実施に加え、寄付管理、返礼品の配送管理、書類発送及び問い合わせ対応等を行っております。自治体に対しては、寄付の拡大に向けた施策と日々の運営業務を一体的に提供し、自治体職員の負担軽減を図っております。また、返礼品提供事業者との継続的な対話を通じて地域産品の魅力を引き出し、商品設計や情報発信等を支援することで、地場産業の振興及び地域の魅力発信につなげております。主な収益は、自治体から受け取る獲得寄付額に応じた受託手数料等であり、その算定方法は契約により異なります。 ［ふるさと納税業務支援関係図］ 当連結会計年度末後の2026年10月１日からは、株式会社フューチャーリンクローカルサポートが本事業を担っております。株式会社公共ＢＰＯによるコールセンター及び書類発送等のバックオフィス業務と、地域の運営パートナー等との連携により、業務の円滑な運営と提供品質の向上に取り組んでおります。 ②　その他（公共案件・地域ポイント）自治体ＤＸ支援や地域共通ポイント等について、企画、システム開発及び運営等を受託し、コンサルティング費用、システム提供費用及び業務委託料等を受け取っております。地域共通ポイントでは、地域内の店舗等で利用できるポイント制度を「まいぷれポイント」の名称で運営しております。地域の店舗の利用やイベントへの参加等に応じてポイントを付与し、地域内での消費を促すとともに、公共施設の利用促進や健康増進等の自治体施策にも活用することで、地域課題の解決と地域経済の循環の両立を図っております。当連結会計年度末現在、全国12エリア・４自治体で運営しております。","policy_period":"2026-08-31"},"prices":{"monthly":{"d":["2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09","2026-10","2026-11"],"p":[2639.0,2160.0,2082.0,1789.0,1650.0,1298.0,1769.0,1273.0,1300.0,1300.0,1086.0,1239.0,1196.0,1119.0,1091.0,1093.0,1125.0,1176.0,1305.0,1120.0,1080.0,1463.0,1330.0,1456.0,1485.0,1299.0,1384.0,1400.0,1330.0,1465.0,1427.0,1437.0,1424.0,1426.0,1897.0,1616.0,1922.0,1416.0,1340.0,1319.0,1289.0,1291.0,1251.0,1260.0,1490.0,1526.0,3275.0,4010.0,2311.0,2170.0,2212.0,1646.0,1744.0,1575.0,1368.0,1361.0,1251.0,1330.0,1438.0,1280.0,1236.0,1203.0,1141.0]},"weekly":{"d":["2023-11-27","2023-12-04","2023-12-11","2023-12-18","2023-12-25","2024-01-01","2024-01-08","2024-01-15","2024-01-22","2024-01-29","2024-02-05","2024-02-12","2024-02-19","2024-02-26","2024-03-04","2024-03-11","2024-03-18","2024-03-25","2024-04-01","2024-04-08","2024-04-15","2024-04-22","2024-04-29","2024-05-06","2024-05-13","2024-05-20","2024-05-27","2024-06-03","2024-06-10","2024-06-17","2024-06-24","2024-07-01","2024-07-08","2024-07-15","2024-07-22","2024-07-29","2024-08-05","2024-08-12","2024-08-19","2024-08-26","2024-09-02","2024-09-09","2024-09-16","2024-09-23","2024-09-30","2024-10-07","2024-10-14","2024-10-21","2024-10-28","2024-11-04","2024-11-11","2024-11-18","2024-11-25","2024-12-02","2024-12-09","2024-12-16","2024-12-23","2024-12-30","2025-01-06","2025-01-13","2025-01-20","202