す。","policy_period":"2025-12"},"prices":{"monthly":{"d":["2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[4510.0,4665.0,3760.0,2579.0,2887.0,4465.0,3650.0,4610.0,4095.0,4445.0,6590.0,5570.0,6380.0,6400.0,6000.0,6210.0,5790.0,5110.0,4105.0,3895.0,3185.0,2850.0,2359.0,3430.0,3180.0,2243.0,2022.0,2100.0,1436.0,1673.0,1487.0,1306.0,1366.0,1311.0,1131.0,1085.0,909.0,986.0,999.0,1065.0,1165.0,1275.0,1377.0,1350.0,1213.0,1282.0,1313.0,1296.0,1203.0,1219.0,1122.0,1177.0,1130.0,1072.0,1041.0,1009.0,1000.0,1052.0,1131.0,1127.0]},"weekly":{"d":["2023-09-04","2023-09-11","2023-09-18","2023-09-25","2023-10-02","2023-10-09","2023-10-16","2023-10-23","2023-10-30","2023-11-06","2023-11-13","2023-11-20","2023-11-27","2023-12-04","2023-12-11","2023-12-18","2023-12-25","2024-01-01","2024-01-08","2024-01-15","2024-01-22","2024-01-29","2024-02-05","2024-02-12","2024-02-19","2024-02-26","2024-03-04","2024-03-11","2024-03-18","2024-03-25","2024-04-01","2024-04-08","2024-04-15","2024-04-22","2024-04-29","2024-05-06","2024-05-13","2024-05-20","2024-05-27","2024-06-03","2024-06-10","2024-06-17","2024-06-24","2024-07-01","2024-07-08","2024-07-15","2024-07-22","2024-07-29","2024-08-05","2024-08-12","2024-08-19","2024-08-26","2024-09-02","2024-09-09","2024-09-16","2024-09-23","2024-09-30","2024-10-07","2024-10-14","2024-10-21","2024-10-28","2024-11-04","2024-11-11","2024-11-18","2024-11-25","2024-12-02","2024-12-09","2024-12-16","2024-12-23","2024-