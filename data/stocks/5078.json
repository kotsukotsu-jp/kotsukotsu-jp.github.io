がある場合を除き、取締役会の決議により定めることができる」旨を定款に定めております。なお、毎事業年度における配当の回数については、期末配当の年１回を基本的な方針としております。この基本方針に基づき、当事業年度の年間配当金につきましては、2026年４月14日開催の取締役会において、前事業年度と同額となる１株当たり135円(配当金総額468百万円)とし、配当金の支払日(効力発生日)を2026年５月11日とさせていただきました。当事業年度に係る剰余金の配当は以下のとおりであります。 決議年月日配当金の総額(百万円)１株当たり配当額(円)2026年４月14日取締役会468135","policy_period":"2026-02"},"prices":{"monthly":{"d":["2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[1691.5,1694.2,1692.4,1717.2,1721.6,1927.3,1863.5,1903.4,2145.4,2214.5,2298.6,2197.9,2199.7,2290.4,2287.6,2289.4,2606.3,2610.0,2634.7,2632.9,2939.6,3145.7,3221.3,3684.1,3825.8,4156.5,3603.8,3797.5,4057.3,4010.0,3788.1,3750.3,4000.6,4293.4,4223.1,4412.8,4719.3,4699.9,4763.1,5565.9,5312.9,5925.9,5955.1,5848.1,4685.3,4724.2,4980.0,4880.0,4960.0,4840.0,4770.0,4750.0,4785.0,4780.0]},"weekly":{"d":["2023-09-04","2023-09-11","2023-09-18","2023-09-25","2023-10-02","2023-10-09","2023-10-16","2023-10-23","2023-10-30","2023-11-06","2023-11-13","2023-11-20","2023-11-27","2023-12-04","2023-12-11","2023-12-18","2023-12-25","2024-01-01","2024-01-08","2024-01-15","2024-01-22","2024-01-29","2024-02-05","2024-02-12","2024-02-19","2024-02-26","2024-03-04","2024-03-11","2024-03-18","2024-03-25","2024-04-01","2024-04-08","2024-04-15","2024-04-22","2024-04-29","2024-05-06","2024-05-13","2024-05-20","2024-05-27","2024-06-03","2024-06-10","2024-06-17","2024-06-24","2024-07-01","2024-07-08","2024-07-15","2024-07-22","2024-07-29","2024-08-05","2024-08-12","2024-08-19","2024-08-26","2024-09-02","2024-09-09","2024-09-16","