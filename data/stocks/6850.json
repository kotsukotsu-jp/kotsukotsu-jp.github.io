。","policy_period":"2026-03"},"prices":{"monthly":{"d":["2016-11","2016-12","2017-01","2017-02","2017-03","2017-04","2017-05","2017-06","2017-07","2017-08","2017-09","2017-10","2017-11","2017-12","2018-01","2018-02","2018-03","2018-04","2018-05","2018-06","2018-07","2018-08","2018-09","2018-10","2018-11","2018-12","2019-01","2019-02","2019-03","2019-04","2019-05","2019-06","2019-07","2019-08","2019-09","2019-10","2019-11","2019-12","2020-01","2020-02","2020-03","2020-04","2020-05","2020-06","2020-07","2020-08","2020-09","2020-10","2020-11","2020-12","2021-01","2021-02","2021-03","2021-04","2021-05","2021-06","2021-07","2021-08","2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09","2026-10"],"p":[384.1,402.5,443.7,471.7,467.0,467.4,457.9,470.4,473.0,463.6,488.2,505.6,594.8,644.7,640.5,647.7,573.7,633.5,636.6,659.9,626.5,603.2,619.5,497.9,575.2,474.6,477.7,506.1,514.8,523.7,456.6,513.2,568.7,500.8,549.0,580.3,570.3,576.7,575.5,460.2,509.6,528.3,600.6,576.9,561.9,580.2,581.9,565.3,591.9,585.2,580.2,568.6,623.2,561.6,627.1,650.2,650.2,623.7,638.2,601.4,613.0,717.1,703.4,669.1,712.8,708.4,745.9,730.4,741.5,730.0,715.9,755.1,810.1,775.4,848.0,880.6,971.7,955.9,989.3,1113.9,1026.8,929.7,921.5,927.0,942.0,996.7,1099.3,1118.5,1209.8,1316.7,1229.7,1201.5,1144.6,1069.1,1071.1,1017.3,974.7,1062.7,1038.3,932.2,955.0,922.3,1100.0,1170.2,1156.2,1222.5,1260.4,1341.9,1354.5,1368.0,1361.3,1805.3,1435.6,1558.2,1717.4,1604.7,1582.9,1669.9,