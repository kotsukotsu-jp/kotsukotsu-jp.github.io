めております。当事業年度については上記方針に基づき、１株当たり30円の期末配当を決議いたしました。決議年月日配当金の総額（百万円）１株当たり配当額（円）2025年６月13日65330.0取締役会決議","policy_period":"2025-04"},"prices":{"monthly":{"d":["2016-10","2016-11","2016-12","2017-01","2017-02","2017-03","2017-04","2017-05","2017-06","2017-07","2017-08","2017-09","2017-10","2017-11","2017-12","2018-01","2018-02","2018-03","2018-04","2018-05","2018-06","2018-07","2018-08","2018-09","2018-10","2018-11","2018-12","2019-01","2019-02","2019-03","2019-04","2019-05","2019-06","2019-07","2019-08","2019-09","2019-10","2019-11","2019-12","2020-01","2020-02","2020-03","2020-04","2020-05","2020-06","2020-07","2020-08","2020-09","2020-10","2020-11","2020-12","2021-01","2021-02","2021-03","2021-04","2021-05","2021-06","2021-07","2021-08","2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[791.7,728.7,711.8,816.5,860.9,793.5,822.5,890.6,807.3,801.1,815.4,890.6,826.1,837.8,1069.6,968.4,839.6,1138.5,969.1,948.4,1056.5,935.8,980.0,986.3,799.8,889.9,662.9,798.0,934.9,863.8,1015.8,919.7,1073.8,1000.4,933.3,830.0,789.2,867.2,869.9,774.7,611.6,584.5,686.2,801.4,656.0,678.8,782.2,870.0,779.5,841.7,828.0,893.8,881.0,915.8,830.7,826.0,727.4,716.3,766.1,1110.0,1217.9,1124.8,935.8,803.9,850.9,809.5,816.7,823.2,746.9,812.9,836.2,852.0,1025.0,1075.2,914.3,1041.8,1052.9,1346.9,1444.1,1477.7,1322.5,1103.6,1127.9,1122.3,964.3,1112.0,1362.7,1417.9,1548.8,1452.5,1377.2,1335.2,1231.4,1322.9,1176.1,1117.0,1218.0,1343.8,1376.2,1279.0,1464.