。期末配当に関する配当金の総額331,247千円及び１株当たり配当額32円につきましては2026年6月24日開催予定の定時株主総会の決議事項となっております。決議年月日配当金の総額（千円）1株当たり配当額（円）2026年６月24日331,24732.00第26期定時株主総会（予定）","policy_period":"2026-03"},"prices":{"monthly":{"d":["2018-07","2018-08","2018-09","2018-10","2018-11","2018-12","2019-01","2019-02","2019-03","2019-04","2019-05","2019-06","2019-07","2019-08","2019-09","2019-10","2019-11","2019-12","2020-01","2020-02","2020-03","2020-04","2020-05","2020-06","2020-07","2020-08","2020-09","2020-10","2020-11","2020-12","2021-01","2021-02","2021-03","2021-04","2021-05","2021-06","2021-07","2021-08","2021-09","2021-10","2021-11","2021-12","2022-01","2022-02","2022-03","2022-04","2022-05","2022-06","2022-07","2022-08","2022-09","2022-10","2022-11","2022-12","2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12","2025-01","2025-02","2025-03","2025-04","2025-05","2025-06","2025-07","2025-08","2025-09","2025-10","2025-11","2025-12","2026-01","2026-02","2026-03","2026-04","2026-05","2026-06","2026-07","2026-08","2026-09"],"p":[453.3,358.7,441.7,322.6,357.4,242.7,309.6,396.1,437.0,473.5,399.1,430.7,402.2,340.7,377.7,418.7,419.6,462.8,495.8,322.4,301.7,417.1,463.2,581.3,695.3,918.3,1003.8,1001.1,947.2,831.0,805.6,891.6,906.2,892.1,799.8,801.6,572.1,629.0,672.6,698.0,646.2,717.6,735.3,663.5,709.4,728.7,964.2,1008.8,933.0,908.2,864.1,843.0,819.6,900.4,968.8,935.3,896.9,876.5,875.1,969.3,851.5,879.3,819.5,779.1,725.8,664.6,736.5,561.2,542.9,600.1,635.0,666.1,634.5,663.3,661.0,703.0,621.3,641.1,702.0,616.6,661.0,753.1,838.6,873.6,950.4,989.8,845.8,765.1,761.3,799.7,886.1,773.8,788.0,784.0,879.0,909.0,1041.0,1071.0,1069.0]},"weekly":{"d":["2023-09-04","2023-09-11","2023-09-18","2023-09-25","2023-10-02","2023-10-09","2023-10-16","2023-10-23","2023-10-30","2023-11-06","2023-11-13","2023-11-20","2023-11-27","2023-12-04","2023-12-